<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather and news headlines. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Today's events from the calendars synced to the phone. Read only, never written. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Elias speaks from a foreground service, so the sound goes on with the screen off (Android 17 requires it). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the processor awake while Elias speaks with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Since Android 11 an app sees only the apps it declares. Without this, TextToSpeech finds no engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
        Backup is off on purpose: personal data must not leave the phone (docs/DECISIONS.md, D9).
        fullBackupContent covers Android 10 and 11, dataExtractionRules covers Android 12 and newer.
    -->
    <application
        android:name=".EliasApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elias">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Plays the spoken briefing (Media3 MediaSessionService). It is exported so the system media controls,
            the lock screen and Bluetooth devices can connect. Other apps only get read access (PlaybackService).
        -->
        <service
            android:name=".data.voice.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
